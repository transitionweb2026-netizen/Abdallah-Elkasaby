# Copy this file to .env.local and fill in before running the CMS or building for production.
# Never commit .env.local — it is already in .gitignore.

# --- Public site -----------------------------------------------------------
# Production origin, e.g. https://www.example-clinic.com (no trailing slash).
# Until this is set, canonical/OG URLs point at the local preview server and
# robots.txt + meta robots ask search engines not to index the site.
NEXT_PUBLIC_SITE_URL=

# Pages are "noindex" until this is "true". Set it for the real launch build
# only — see `npm run check:content` first.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- CMS (Supabase) ---------------------------------------------------------
# Without these two, /admin/ runs as a local demo: fully usable, but nothing
# saved there ever reaches the live website. See docs/SUPABASE.md for where
# to find them and how to connect a real project.
#
# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API keys -> "publishable" key
# (starts with sb_publishable_, or the legacy "anon" key). This key is safe
# to expose publicly — Row Level Security is what actually protects the data.
#
# NEVER put the secret / service_role key here, or in any NEXT_PUBLIC_
# variable: it would be embedded in the website's JavaScript bundle. Every
# script in this project that reads this key refuses to run if it looks like
# a secret key instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
